<Window x:Class="DriverScanTester.Views.BotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bot Control Panel" Height="720" Width="980"
        MinWidth="820" MinHeight="570"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Persistent global runtime actions, independent of the selected tab. -->
        <Border Grid.Row="0" BorderBrush="#FFD3D9DF" BorderThickness="1" CornerRadius="5"
                Background="#FFF7F8FA" Padding="6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Padding="7,4" Margin="3,2" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnyRuntimeActive}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F3EA"/>
                                        <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBotPaused}" Value="True">
                                        <Setter Property="Background" Value="#FFFFF3D6"/>
                                        <Setter Property="BorderBrush" Value="#FFE5CF82"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                    <Setter Property="Text" Value="Overall: Idle"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnyRuntimeActive}" Value="True">
                                            <Setter Property="Text" Value="Overall: Running"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBotPaused}" Value="True">
                                            <Setter Property="Text" Value="Overall: Paused"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Padding="7,4" Margin="3,2" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMovementBotRunning}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F3EA"/>
                                        <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                    <Setter Property="Text" Value="Movement: Off"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMovementBotRunning}" Value="True">
                                            <Setter Property="Text" Value="Movement: Running"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Padding="7,4" Margin="3,2" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHealManaBotRunning}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F3EA"/>
                                        <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                    <Setter Property="Text" Value="Heal/Mana: Off"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHealManaBotRunning}" Value="True">
                                            <Setter Property="Text" Value="Heal/Mana: Running"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Padding="7,4" Margin="3,2" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLootBotRunning}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F3EA"/>
                                        <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                    <Setter Property="Text" Value="Loot: Off"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLootBotRunning}" Value="True">
                                            <Setter Property="Text" Value="Loot: Running"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Padding="7,4" Margin="3,2" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkflowRunning}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F3EA"/>
                                        <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                    <Setter Property="Text" Value="Workflow: Off"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWorkflowRunning}" Value="True">
                                            <Setter Property="Text" Value="Workflow: Running"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Pause" Command="{Binding PauseBotCommand}"
                            ToolTip="Freeze the bot in place. Resume continues where it was paused.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WarningActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBotPaused}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Resume" Command="{Binding ResumeBotCommand}"
                            ToolTip="Resume the paused bot where it was paused.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StartActionButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBotPaused}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Stop All" Command="{Binding StopBotCommand}"
                            Style="{StaticResource DangerActionButtonStyle}" MinWidth="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Run">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <GroupBox Header="Route Workflow" Margin="0,0,0,10" Padding="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Profile:" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileNames}"
                                              SelectedItem="{Binding SelectedProfileName}"
                                              IsEditable="True" IsTextSearchEnabled="True" VerticalAlignment="Center"
                                              Margin="3,0"/>
                                    <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshProfilesCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    <Button Grid.Column="3" Content="Validate" Command="{Binding ValidateProfileCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    <Button Grid.Column="4" Content="Start Workflow" Command="{Binding StartWorkflowCommand}"
                                            Style="{StaticResource StartActionButtonStyle}"/>
                                    <Button Grid.Column="5" Content="Stop Workflow" Command="{Binding StopWorkflowCommand}"
                                            Style="{StaticResource ScopedDangerActionButtonStyle}"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="0.75*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Workflow status" FontSize="10" Foreground="Gray"/>
                                            <TextBlock FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Off"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWorkflowRunning}" Value="True">
                                                                <Setter Property="Text" Value="Running"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Current stage" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding WorkflowPhaseText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Cycles" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding WorkflowCycleCount}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Run duration (min)" FontSize="10" Foreground="Gray"
                                                       ToolTip="Optional limit. Empty or 0 runs indefinitely."/>
                                            <TextBox Text="{Binding RunDurationMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="70" ToolTip="Applies to Start Workflow and Start Manual Bot."/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Auto-stop remaining" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding RunTimeRemainingText}" FontWeight="SemiBold" Foreground="#FF245B91"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Background="#FFF7F8FA" BorderBrush="#FFE0E4E8"
                                        BorderThickness="1" CornerRadius="3" Padding="5" Margin="2,0">
                                    <ScrollViewer MaxHeight="54" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding ValidationText}" TextWrapping="Wrap" Foreground="#FF555D65" FontSize="11"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Combat Assistance" Margin="0,0,0,10" Padding="7">
                            <DockPanel LastChildFill="False">
                                <CheckBox Content="Enable Mob Grouping"
                                          IsChecked="{Binding MobGroupingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" Margin="4,2"
                                          ToolTip="Global runtime option. Runs only on MoveAndAttack waypoints and cancels for recovery, loot holds, pause, or Repot."/>
                                <Border DockPanel.Dock="Right" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="6,0,2,0">
                                    <TextBlock Text="{Binding MobGroupingStatus}" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Manual Controls" Margin="0,0,0,10" Padding="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox Grid.Column="0" Header="Movement" Margin="0,0,5,0" Padding="6">
                                    <StackPanel>
                                        <WrapPanel>
                                            <Button Content="Start Manual Bot" Command="{Binding RunBotCommand}"
                                                    Style="{StaticResource StartActionButtonStyle}"/>
                                            <Button Content="Path / Profile Editor" Command="{Binding OpenPathEditorCommand}"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"/>
                                        </WrapPanel>
                                        <TextBlock Text="Starting manual movement also starts loot automatically."
                                                   FontSize="10" Foreground="Gray" FontStyle="Italic"
                                                   TextWrapping="Wrap" Margin="5,2,5,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Column="1" Header="Heal / Mana" Margin="5,0,0,0" Padding="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="HP threshold" VerticalAlignment="Center" Margin="3"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HpThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="68" VerticalAlignment="Center" Margin="3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="key 1" VerticalAlignment="Center" Foreground="Gray" Margin="5,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mana threshold" VerticalAlignment="Center" Margin="3"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ManaThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="68" VerticalAlignment="Center" Margin="3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="key 2" VerticalAlignment="Center" Foreground="Gray" Margin="5,3"/>
                                        <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="0,5,0,0">
                                            <Button Content="Start/Stop Heal-Mana" Command="{Binding ToggleHealManaBotCommand}"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"/>
                                            <Border Padding="7,4" Margin="4" CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHealManaBotRunning}" Value="True">
                                                                <Setter Property="Background" Value="#FFE8F3EA"/>
                                                                <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                                            <Setter Property="Text" Value="Off"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHealManaBotRunning}" Value="True">
                                                                    <Setter Property="Text" Value="Running"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Live Player Stats" Padding="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource RuntimeBadgeBorderStyle}">
                                    <StackPanel><TextBlock Text="HP" FontSize="10" Foreground="Gray"/><TextBlock Text="{Binding CurrentHp}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource RuntimeBadgeBorderStyle}">
                                    <StackPanel><TextBlock Text="Mana" FontSize="10" Foreground="Gray"/><TextBlock Text="{Binding CurrentMana}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource RuntimeBadgeBorderStyle}">
                                    <StackPanel><TextBlock Text="HP Potions" FontSize="10" Foreground="Gray"/><TextBlock Text="{Binding HpPotCount}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource RuntimeBadgeBorderStyle}">
                                    <StackPanel><TextBlock Text="Mana Potions" FontSize="10" Foreground="Gray"/><TextBlock Text="{Binding ManaPotCount}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <GroupBox Header="Test Operation — diagnostic tool" Margin="0,0,0,10" Padding="7">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Operation:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableOperationNames}"
                                          SelectedItem="{Binding SelectedOperationName}"
                                          IsTextSearchEnabled="True" VerticalAlignment="Center" Margin="3"/>
                                <Button Grid.Column="2" Content="Test Operation" Command="{Binding TestOperationCommand}"
                                        Style="{StaticResource SecondaryActionButtonStyle}"/>
                                <Border Grid.Column="3" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="4">
                                    <TextBlock Text="{Binding OperationTestStatus}" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="Runs the selected bot operation once (for example Enter_COT) with the same services as the workflow."
                                       FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="4,7,4,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Calibration" Margin="0,0,0,10" Padding="7">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Capture NPC Mouseover" Command="{Binding CaptureNpcMouseOverCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            ToolTip="Najedz kursorem na NPC (sprzedawce, u ktorego bot ma sprzedawac) i kliknij. Zapisze pelny dump wartosci do MouseOverValues_Log.txt i ustawi SellerPointedValue."/>
                                    <Button Content="Capture Item Mouseover" Command="{Binding CaptureItemMouseOverCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            ToolTip="Najedz kursorem na item (loot) i kliknij. Zapisze pelny dump wartosci do MouseOverValues_Log.txt i ustawi LootMouseOverValue."/>
                                </WrapPanel>
                                <TextBlock Text="Hover the target NPC or item in the game, then capture its mouseover value. Calibration is saved to MouseCalibration.json and restored on restart."
                                           FontSize="10" Foreground="Gray" Margin="5,2,5,0" TextWrapping="Wrap" FontStyle="Italic"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Hotkeys / Shortcuts" Padding="7">
                            <Grid Margin="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Home" FontWeight="Bold" Margin="4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Toggle Movement Bot" Margin="4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Page Up" FontWeight="Bold" Margin="4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Toggle Heal/Mana Bot" Margin="4"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="End" FontWeight="Bold" Margin="4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Toggle Loot Bot" Margin="4"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Log">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="Clear Log" Command="{Binding ClearBotLogCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            HorizontalAlignment="Right" Margin="2,0,2,6"/>
                    <TextBox Grid.Row="1" x:Name="BotLogBox" Text="{Binding BotLogText, Mode=OneWay}"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="10"
                             Background="#FFF9F9F9"
                             TextChanged="BotLogBox_TextChanged"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
