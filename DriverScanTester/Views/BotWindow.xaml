<Window x:Class="DriverScanTester.Views.BotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bot Control Panel" Height="720" Width="980"
        MinWidth="820" MinHeight="570"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Persistent global runtime actions, independent of the selected tab. -->
        <Border Grid.Row="0" BorderBrush="#FFD3D9DF" BorderThickness="1" CornerRadius="5"
                Background="#FFF7F8FA" Padding="6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Padding="7,4" Margin="3,2" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnyRuntimeActive}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F3EA"/>
                                        <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBotPaused}" Value="True">
                                        <Setter Property="Background" Value="#FFFFF3D6"/>
                                        <Setter Property="BorderBrush" Value="#FFE5CF82"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                    <Setter Property="Text" Value="Overall: Idle"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnyRuntimeActive}" Value="True">
                                            <Setter Property="Text" Value="Overall: Running"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBotPaused}" Value="True">
                                            <Setter Property="Text" Value="Overall: Paused"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Padding="7,4" Margin="3,2" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMovementBotRunning}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F3EA"/>
                                        <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                    <Setter Property="Text" Value="Movement: Off"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMovementBotRunning}" Value="True">
                                            <Setter Property="Text" Value="Movement: Running"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Padding="7,4" Margin="3,2" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHealManaBotRunning}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F3EA"/>
                                        <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                    <Setter Property="Text" Value="Heal/Mana: Off"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHealManaBotRunning}" Value="True">
                                            <Setter Property="Text" Value="Heal/Mana: Running"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Padding="7,4" Margin="3,2" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLootBotRunning}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F3EA"/>
                                        <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                    <Setter Property="Text" Value="Loot: Off"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLootBotRunning}" Value="True">
                                            <Setter Property="Text" Value="Loot: Running"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Padding="7,4" Margin="3,2" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkflowRunning}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F3EA"/>
                                        <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                    <Setter Property="Text" Value="Workflow: Off"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWorkflowRunning}" Value="True">
                                            <Setter Property="Text" Value="Workflow: Running"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Pause" Command="{Binding PauseBotCommand}"
                            ToolTip="Freeze the bot in place. Resume continues where it was paused.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WarningActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBotPaused}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Resume" Command="{Binding ResumeBotCommand}"
                            ToolTip="Resume the paused bot where it was paused.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StartActionButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBotPaused}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Stop All" Command="{Binding StopBotCommand}"
                            Style="{StaticResource DangerActionButtonStyle}" MinWidth="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Offline (not attached) notice: everything except game actions still works. -->
        <Border Grid.Row="1" BorderBrush="#FFE5CF82" BorderThickness="1" CornerRadius="5"
                Background="#FFFFF7E0" Padding="8,5" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGameAttached}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="PID:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#FF6C5416" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding PidText, UpdateSourceTrigger=PropertyChanged}" Width="70" VerticalAlignment="Center"/>
                    <Button Content="Attach" Command="{Binding AttachCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Margin="6,0,0,0"
                            ToolTip="Attach to the game process using the PID above. It is the same Attach as on the main window."/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="⚠" FontSize="14" FontWeight="Bold" Foreground="#FF6C5416" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding AttachmentStatusText}" TextWrapping="Wrap" Foreground="#FF6C5416" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Run">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <GroupBox Header="Route Workflow" Margin="0,0,0,10" Padding="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Profile:" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileNames}"
                                              SelectedItem="{Binding SelectedProfileName}"
                                              IsEditable="True" IsTextSearchEnabled="True" VerticalAlignment="Center"
                                              Margin="3,0"/>
                                    <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshProfilesCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    <Button Grid.Column="3" Content="Validate" Command="{Binding ValidateProfileCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    <Button Grid.Column="4" Content="Start Workflow" Command="{Binding StartWorkflowCommand}"
                                            Style="{StaticResource StartActionButtonStyle}"/>
                                    <Button Grid.Column="5" Content="Stop Workflow" Command="{Binding StopWorkflowCommand}"
                                            Style="{StaticResource ScopedDangerActionButtonStyle}"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="0.75*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Workflow status" FontSize="10" Foreground="Gray"/>
                                            <TextBlock FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Off"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWorkflowRunning}" Value="True">
                                                                <Setter Property="Text" Value="Running"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Current stage" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding WorkflowPhaseText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Cycles" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding WorkflowCycleCount}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Run duration (min)" FontSize="10" Foreground="Gray"
                                                       ToolTip="Optional limit. Empty or 0 runs indefinitely."/>
                                            <TextBox Text="{Binding RunDurationMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="70" ToolTip="Applies to Start Workflow and Start Manual Bot."/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Auto-stop remaining" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding RunTimeRemainingText}" FontWeight="SemiBold" Foreground="#FF245B91"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Background="#FFF7F8FA" BorderBrush="#FFE0E4E8"
                                        BorderThickness="1" CornerRadius="3" Padding="5" Margin="2,0">
                                    <ScrollViewer MaxHeight="54" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding ValidationText}" TextWrapping="Wrap" Foreground="#FF555D65" FontSize="11"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Combat Assistance" Margin="0,0,0,10" Padding="7">
                            <StackPanel>
                                <CheckBox Content="Stop and teleport to city when another player is detected"
                                          IsChecked="{Binding StopOnOtherPlayerDetected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" Margin="4,2"
                                          ToolTip="Checked by default: after saving the other-player screenshot, stop the bot and return to the city. Uncheck to save screenshots but keep working normally."/>
                                <DockPanel LastChildFill="False" Margin="0,3,0,0">
                                    <CheckBox Content="Enable Mob Grouping"
                                              IsChecked="{Binding MobGroupingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" Margin="4,2"
                                              ToolTip="Global runtime option. Runs only on MoveAndAttack waypoints and cancels for recovery, loot holds, pause, or Repot."/>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="6,0,2,0">
                                        <TextBlock Text="{Binding MobGroupingStatus}" FontWeight="SemiBold"/>
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Manual Controls" Margin="0,0,0,10" Padding="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox Grid.Column="0" Header="Movement" Margin="0,0,5,0" Padding="6">
                                    <StackPanel>
                                        <WrapPanel>
                                            <Button Content="Start Manual Bot" Command="{Binding RunBotCommand}"
                                                    Style="{StaticResource StartActionButtonStyle}"
                                                    ToolTip="Requires an attached game (Attach on the main window). Profile editing and the log work offline."/>
                                            <Button Content="Path / Profile Editor" Command="{Binding OpenPathEditorCommand}"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"/>
                                        </WrapPanel>
                                        <TextBlock Text="Starting manual movement also starts loot automatically."
                                                   FontSize="10" Foreground="Gray" FontStyle="Italic"
                                                   TextWrapping="Wrap" Margin="5,2,5,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Column="1" Header="Heal / Mana" Margin="5,0,0,0" Padding="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="HP threshold" VerticalAlignment="Center" Margin="3"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HpThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="68" VerticalAlignment="Center" Margin="3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="key 1" VerticalAlignment="Center" Foreground="Gray" Margin="5,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mana threshold" VerticalAlignment="Center" Margin="3"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ManaThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="68" VerticalAlignment="Center" Margin="3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="key 2" VerticalAlignment="Center" Foreground="Gray" Margin="5,3"/>
                                        <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="0,5,0,0">
                                            <Button Content="Start/Stop Heal-Mana" Command="{Binding ToggleHealManaBotCommand}"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"/>
                                            <Border Padding="7,4" Margin="4" CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource RuntimeBadgeBorderStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHealManaBotRunning}" Value="True">
                                                                <Setter Property="Background" Value="#FFE8F3EA"/>
                                                                <Setter Property="BorderBrush" Value="#FF9BC5A2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RuntimeBadgeTextStyle}">
                                                            <Setter Property="Text" Value="Off"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHealManaBotRunning}" Value="True">
                                                                    <Setter Property="Text" Value="Running"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Live Player Stats" Padding="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource RuntimeBadgeBorderStyle}">
                                    <StackPanel><TextBlock Text="HP" FontSize="10" Foreground="Gray"/><TextBlock Text="{Binding CurrentHp}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource RuntimeBadgeBorderStyle}">
                                    <StackPanel><TextBlock Text="Mana" FontSize="10" Foreground="Gray"/><TextBlock Text="{Binding CurrentMana}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource RuntimeBadgeBorderStyle}">
                                    <StackPanel><TextBlock Text="HP Potions" FontSize="10" Foreground="Gray"/><TextBlock Text="{Binding HpPotCount}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource RuntimeBadgeBorderStyle}">
                                    <StackPanel><TextBlock Text="Mana Potions" FontSize="10" Foreground="Gray"/><TextBlock Text="{Binding ManaPotCount}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <GroupBox Header="Test Operation — diagnostic tool" Margin="0,0,0,10" Padding="7">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Operation:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableOperationNames}"
                                          SelectedItem="{Binding SelectedOperationName}"
                                          IsTextSearchEnabled="True" VerticalAlignment="Center" Margin="3"/>
                                <Button Grid.Column="2" Content="Test Operation" Command="{Binding TestOperationCommand}"
                                        Style="{StaticResource SecondaryActionButtonStyle}"/>
                                <Border Grid.Column="3" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="4">
                                    <TextBlock Text="{Binding OperationTestStatus}" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="Runs the selected bot operation once (for example Enter_COT) with the same services as the workflow."
                                       FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="4,7,4,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Loot Pickup Test — diagnostic" Margin="0,0,0,10" Padding="7">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Test SOD/SOP Loot" Command="{Binding TestLootSodSopCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            ToolTip="Uruchamia prawdziwy loot SOD/SOP: zoom kamery, zrzut okna gry, skan rozowych pikseli, najechanie na kandydatow i klikniecie zbiorki. Szczegoly w zakladce Log."/>
                                    <Button Content="Test White Pixel Loot" Command="{Binding TestLootWhiteCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            ToolTip="Uruchamia prawdziwy loot zwyklych przedmiotow: zoom kamery, zrzut okna gry, skan bialych pikseli w malym i duzym regionie, najechanie i klikniecie zbiorki. Szczegoly w zakladce Log."/>
                                    <Border Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="6,4,4,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LootScanTestStatus}" FontWeight="SemiBold"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="Runs the real loot pickup logic once: zooms the loot camera, captures the game client, scans pixels, probes the mouseover calibration and clicks the matching item. Stop the movement/loot bot and workflow first. Test-loot screenshots are saved to Screenshots/LootTest in the project (visible in Git Changes); details go to the Log tab."
                                           FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="4,7,4,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Movement Synchronization Diagnostic" Margin="0,0,0,10" Padding="7">
                            <StackPanel>
                                <TextBlock Text="Independent experiment runner. It never changes the production movement system. Run one experiment at a time and observe the character on the second client."
                                           FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="3,0,3,6"/>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Scenario:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,6,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding MovementDiagnosticScenarios}"
                                              SelectedItem="{Binding SelectedMovementDiagnosticScenario}"
                                              DisplayMemberPath="DisplayText"
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="Duration (s):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding MovementDiagnosticDurationText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="1–300 s. TEST 0 defaults to 15 s; other tests default to 6 s." VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Repeat (ms):" VerticalAlignment="Center" Margin="8,0,5,0"/>
                                    <TextBox Grid.Column="5" Text="{Binding MovementDiagnosticRepeatIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="TEST 2 repeated W-down interval: 20–2000 ms." VerticalAlignment="Center"/>
                                </Grid>

                                <WrapPanel Margin="0,0,0,5">
                                    <Button Content="Start Test" Command="{Binding StartMovementDiagnosticCommand}" Style="{StaticResource StartActionButtonStyle}"/>
                                    <Button Content="Stop Test" Command="{Binding StopMovementDiagnosticCommand}" Style="{StaticResource ScopedDangerActionButtonStyle}"/>
                                    <Button Content="Start Post-Test Observation" Command="{Binding StartMovementDiagnosticObservationCommand}" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    <Button Content="Stop Observation" Command="{Binding StopMovementDiagnosticObservationCommand}" Style="{StaticResource ScopedDangerActionButtonStyle}"/>
                                    <Button Content="Mark Movement Recovered" Command="{Binding MarkMovementRecoveryCommand}" Style="{StaticResource WarningActionButtonStyle}"
                                            ToolTip="Record the exact moment the other client finally shows normal movement. Recovery duration is computed from the confirmed input-stop timestamp."/>
                                    <Button Content="Export Report" Command="{Binding ExportMovementDiagnosticReportCommand}" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                </WrapPanel>

                                <CheckBox Content="Enable advanced mode (DirectCamera memory steering — TEST 8)"
                                          IsChecked="{Binding MovementDiagnosticAdvancedMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="3,2" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MovementDiagnosticAdvancedHintText}" FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="22,0,3,3"/>

                                <Border Background="#FFF7F8FA" BorderBrush="#FFE0E4E8" BorderThickness="1" CornerRadius="3" Padding="6" Margin="2,3">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MovementDiagnosticSelectedInputMethodText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding MovementDiagnosticScenarioHintText}" FontSize="10" Foreground="#FF555D65" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.0*"/>
                                        <ColumnDefinition Width="1.0*"/>
                                        <ColumnDefinition Width="1.0*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Current state" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding MovementDiagnosticStateText}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Elapsed" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding MovementDiagnosticElapsedText}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Countdown / progress" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding MovementDiagnosticCountdownText}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding MovementDiagnosticProgressText}" FontSize="10" Foreground="#FF555D65"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource RuntimeBadgeBorderStyle}" Margin="2">
                                        <StackPanel>
                                            <TextBlock Text="Recovery" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding MovementDiagnosticRecoveryText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding MovementDiagnosticMessageText}" TextWrapping="Wrap" Foreground="#FF245B91" FontWeight="SemiBold" Margin="3,4"/>
                                <TextBlock Text="{Binding MovementDiagnosticCheckpointText}" TextWrapping="Wrap" Foreground="#FF555D65" FontSize="10" Margin="3,0,3,3"/>
                                <TextBlock Text="{Binding MovementDiagnosticLastResultText}" TextWrapping="Wrap" FontSize="10" Foreground="#FF555D65" Margin="3,0,3,3"/>
                                <TextBlock Text="{Binding MovementDiagnosticReportDirectoryText}" TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="3,0,3,3"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TEST 9 safe waypoint X:" VerticalAlignment="Center" Margin="3,0,5,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding MovementDiagnosticWaypointXText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="8,0,5,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding MovementDiagnosticWaypointYText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Required only for TEST 9; configure a point 0.5–30 units ahead. No default is invented." FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" Grid.ColumnSpan="3" TextWrapping="Wrap"/>
                                </Grid>

                                <GroupBox Header="Remote-client observation (user-reported)" Margin="0,6,0,0" Padding="6">
                                    <StackPanel>
                                        <TextBlock Text="Record what the OTHER game client showed. These values are stored as observer reports, not automatic measurements."
                                                   FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="2,0,2,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Observed:" VerticalAlignment="Center" Margin="2,2,6,2"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding MovementDiagnosticObservationChoices}"
                                                      SelectedItem="{Binding SelectedMovementDiagnosticObservation}"
                                                      DisplayMemberPath="Label" Margin="2"/>
                                            <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2">
                                                <CheckBox Content="Problem persisted after synthetic input stopped"
                                                          IsChecked="{Binding MovementDiagnosticPersistedAfterStop, Mode=TwoWay}" Margin="2,2,12,2"/>
                                                <CheckBox Content="Problem observed during subsequent manual movement"
                                                          IsChecked="{Binding MovementDiagnosticObservedDuringManualMovement, Mode=TwoWay}" Margin="2,2,12,2"/>
                                            </WrapPanel>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Notes:" VerticalAlignment="Top" Margin="2,6,6,2"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MovementDiagnosticNotesText, UpdateSourceTrigger=PropertyChanged}"
                                                     MinHeight="42" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="2"/>
                                            <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,3,0,0">
                                                <Button Content="Save Observation Without Rerunning" Command="{Binding RecordMovementDiagnosticObservationCommand}"
                                                        Style="{StaticResource SecondaryActionButtonStyle}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <TextBlock Text="Telemetry: events.csv, samples.csv, session.json and report.txt under Logs/MovementSyncDiagnostics. Local memory X/Y values are not server positions. EXPECTED PULSE MOVEMENT in TEST 5 is not proof of the original defect."
                                           FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="3,5,3,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Calibration" Margin="0,0,0,10" Padding="7">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Capture NPC Mouseover" Command="{Binding CaptureNpcMouseOverCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            ToolTip="Najedz kursorem na NPC (sprzedawce, u ktorego bot ma sprzedawac) i kliknij. Zapisze pelny dump wartosci do MouseOverValues_Log.txt i ustawi SellerPointedValue."/>
                                    <Button Content="Capture Item Mouseover" Command="{Binding CaptureItemMouseOverCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            ToolTip="Najedz kursorem na item (loot) i kliknij. Zapisze pelny dump wartosci do MouseOverValues_Log.txt i ustawi LootMouseOverValue."/>
                                </WrapPanel>
                                <TextBlock Text="Hover the target NPC or item in the game, then capture its mouseover value. Calibration is saved to MouseCalibration.json and restored on restart."
                                           FontSize="10" Foreground="Gray" Margin="5,2,5,0" TextWrapping="Wrap" FontStyle="Italic"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Hotkeys / Shortcuts" Padding="7">
                            <Grid Margin="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Home" FontWeight="Bold" Margin="4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Toggle Movement Bot" Margin="4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Page Up" FontWeight="Bold" Margin="4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Toggle Heal/Mana Bot" Margin="4"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="End" FontWeight="Bold" Margin="4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Toggle Loot Bot" Margin="4"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Log">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="Clear Log" Command="{Binding ClearBotLogCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            HorizontalAlignment="Right" Margin="2,0,2,6"/>
                    <TextBox Grid.Row="1" x:Name="BotLogBox" Text="{Binding BotLogText, Mode=OneWay}"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="10"
                             Background="#FFF9F9F9"
                             TextChanged="BotLogBox_TextChanged"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
