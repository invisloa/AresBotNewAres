<Window x:Class="DriverScanTester.Views.BotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DriverScanTester.ViewModels"
        mc:Ignorable="d"
        Title="Bot Control Panel" Height="680" Width="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Status Bar -->
        <Border Grid.Row="0" BorderBrush="#FF007ACC" BorderThickness="2" CornerRadius="4" Padding="8" Margin="0,0,0,10" Background="#FFF0F8FF">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Status:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="Move:" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding IsMovementBotRunning}" VerticalAlignment="Center" Width="40"/>
                <TextBlock Text="Heal:" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBlock Text="{Binding IsHealManaBotRunning}" VerticalAlignment="Center" Width="40"/>
                <TextBlock Text="Loot:" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBlock Text="{Binding IsLootBotRunning}" VerticalAlignment="Center" Width="40"/>
                <TextBlock Text="Workflow:" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBlock Text="{Binding IsWorkflowRunning}" VerticalAlignment="Center" Width="40"/>
                <Separator Width="1" Margin="15,2" Background="LightGray"/>
                <TextBlock Text="Any bot running:" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBlock Text="{Binding IsAnyBotRunning}" VerticalAlignment="Center" FontWeight="Bold" Width="40"/>
                <Separator Width="1" Margin="15,2" Background="LightGray"/>
                <Button Content="STOP ALL BOTS" Command="{Binding StopBotCommand}" Width="120" Margin="5,0" Background="#FFFFD0D0" FontWeight="Bold"/>
            </WrapPanel>
        </Border>

        <!-- Row 1: Movement Bot + Heal/Mana Bot -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Movement Bot -->
            <GroupBox Header="Movement Bot (HotKey: Home)" Grid.Column="0" Margin="0,0,5,0">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal" Margin="5">
                        <Button Content="RUN BOT" Command="{Binding RunBotCommand}" Width="100" Margin="2" Background="#FFDEFFDE" FontWeight="Bold"/>
                        <Button Content="Path Editor" Command="{Binding OpenPathEditorCommand}" Width="100" Margin="10,2,2,2" Background="#FFF0F0FF"/>
                    </WrapPanel>
                    <TextBlock Text="Running the movement bot auto-starts the loot bot (hotkey End stops it)."
                               FontSize="9" Foreground="Gray" Margin="5,0,0,5" TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </GroupBox>

            <!-- Heal/Mana Bot -->
            <GroupBox Header="Heal / Mana Bot (HotKey: Page Up)" Grid.Column="1" Margin="5,0,0,0">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal" Margin="5">
                        <Label Content="HP Threshold:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox Width="60" Text="{Binding HpThresholdText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="2,0"/>
                        <Label Content="(uses key '1')" VerticalAlignment="Center" Margin="5,0,0,0" FontStyle="Italic"/>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="5">
                        <Label Content="Mana Threshold:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox Width="60" Text="{Binding ManaThresholdText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="2,0"/>
                        <Label Content="(uses key '2')" VerticalAlignment="Center" Margin="5,0,0,0" FontStyle="Italic"/>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="5">
                        <Button Content="Toggle Heal/Mana Bot" Command="{Binding ToggleHealManaBotCommand}" Width="160" Margin="2" Background="#FFFFF0D0"/>
                        <TextBlock Text="Status:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                        <TextBlock Text="{Binding IsHealManaBotRunning}" VerticalAlignment="Center" FontWeight="Bold"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Row 2: Route Workflow -->
        <GroupBox Grid.Row="2" Header="Route Workflow" Margin="0,0,0,10" BorderBrush="#FF3399FF" BorderThickness="1">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="5,3">
                    <TextBlock Text="Profile:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ProfileNames}"
                              SelectedItem="{Binding SelectedProfileName}"
                              Width="140" VerticalAlignment="Center" Margin="5,0"
                              IsEditable="True" IsTextSearchEnabled="True"/>
                    <Button Content="Refresh" Command="{Binding RefreshProfilesCommand}"
                            Width="60" Margin="3,0" FontSize="10"/>
                    <Button Content="Validate" Command="{Binding ValidateProfileCommand}"
                            Width="60" Margin="3,0" FontSize="10"/>
                    <Separator Width="1" Margin="5,2" Background="LightGray"/>
                    <Button Content="Start" Command="{Binding StartWorkflowCommand}"
                            Width="70" Margin="2" Background="#FFDEFFDE" FontWeight="Bold"/>
                    <Button Content="Stop" Command="{Binding StopWorkflowCommand}"
                            Width="70" Margin="3,2" Background="#FFFFD0D0" FontWeight="Bold"/>
                </WrapPanel>
                <WrapPanel Orientation="Horizontal" Margin="5,0,5,3">
                    <TextBlock Text="Running:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding IsWorkflowRunning}" VerticalAlignment="Center" Width="30" Margin="3,0"/>
                    <Separator Width="1" Margin="10,2" Background="LightGray"/>
                    <TextBlock Text="Current stage:" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,3,0"/>
                    <TextBlock Text="{Binding WorkflowPhaseText}" VerticalAlignment="Center" FontWeight="Bold"
                               Foreground="#FF007ACC" MinWidth="140"/>
                    <Separator Width="1" Margin="10,2" Background="LightGray"/>
                    <TextBlock Text="Validation:" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,3,0"/>
                    <TextBlock Text="{Binding ValidationText}" VerticalAlignment="Center" Foreground="Gray" FontSize="10"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!-- Row 3: Test Method + Calibration -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Test Method -->
            <GroupBox Header="Test Method" Grid.Column="0" Margin="0,0,5,0" BorderBrush="#FFFF8800" BorderThickness="1">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Operation:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding AvailableOperationNames}"
                                  SelectedItem="{Binding SelectedOperationName}"
                                  Width="170" VerticalAlignment="Center" Margin="5,0"
                                  IsTextSearchEnabled="True"/>
                        <Button Content="TEST" Command="{Binding TestOperationCommand}" Width="80"
                                Margin="5,0" Background="#FFFFD080" FontWeight="Bold"/>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="5,0,5,5">
                        <TextBlock Text="Result:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OperationTestStatus}" VerticalAlignment="Center" Margin="5,0"
                                   FontWeight="Bold" Foreground="#FF007ACC" MinWidth="80"/>
                    </WrapPanel>
                    <TextBlock Text="Runs the selected bot operation once (e.g. Enter_COT) with the same services as the workflow."
                               FontSize="9" Foreground="Gray" Margin="5,0,0,5" TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </GroupBox>

            <!-- Calibration -->
            <GroupBox Header="Calibration" Grid.Column="1" Margin="5,0,0,0" BorderBrush="#FFE0E0E0" BorderThickness="1">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal" Margin="5">
                        <Button Content="Mouseover NPC" Command="{Binding CaptureNpcMouseOverCommand}" Width="130" Margin="0,0,5,0" Background="#FFE0E0FF" ToolTip="Najedz kursorem na NPC (sprzedawce, u ktorego bot ma sprzedawac) i kliknij. Zapisze pelny dump wartosci do MouseOverValues_Log.txt i ustawi SellerPointedValue."/>
                        <Button Content="Mouseover Item" Command="{Binding CaptureItemMouseOverCommand}" Width="130" Margin="0" Background="#FFE0E0FF" ToolTip="Najedz kursorem na item (loot) i kliknij. Zapisze pelny dump wartosci do MouseOverValues_Log.txt i ustawi LootMouseOverValue."/>
                    </WrapPanel>
                    <TextBlock Text="Hover the target NPC / item in the game, then click to capture the mouseover value. Saved to MouseCalibration.json and restored on restart."
                               FontSize="9" Foreground="Gray" Margin="5,0,0,5" TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Row 4: Live Player Stats + Hotkeys -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Live Player Stats -->
            <GroupBox Header="Live Player Stats" Grid.Column="0" Margin="0,0,5,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock FontWeight="Bold" Text="HP" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding CurrentHp}" FontSize="18" Foreground="#FFCC0000"/>
                        <TextBlock FontWeight="Bold" Text="Mana" Margin="0,8,0,2"/>
                        <TextBlock Text="{Binding CurrentMana}" FontSize="18" Foreground="#FF0000CC"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock FontWeight="Bold" Text="HP Potions" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding HpPotCount}" FontSize="18"/>
                        <TextBlock FontWeight="Bold" Text="Mana Potions" Margin="0,8,0,2"/>
                        <TextBlock Text="{Binding ManaPotCount}" FontSize="18"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Hotkeys -->
            <GroupBox Header="Hotkeys" Grid.Column="1" Margin="5,0,0,0">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal" Margin="8,4">
                        <TextBlock FontWeight="Bold" Width="70">Home</TextBlock>
                        <TextBlock>- Toggle Movement Bot</TextBlock>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="8,4">
                        <TextBlock FontWeight="Bold" Width="70">Page Up</TextBlock>
                        <TextBlock>- Toggle Heal/Mana Bot</TextBlock>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="8,4">
                        <TextBlock FontWeight="Bold" Width="70">End</TextBlock>
                        <TextBlock>- Toggle Loot Bot</TextBlock>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Row 5: Bot-Specific Log -->
        <GroupBox Grid.Row="5" Header="Bot Log" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="Clear Log" Command="{Binding ClearBotLogCommand}"
                        HorizontalAlignment="Right" Padding="6,1" FontSize="10" Margin="0,0,0,2" Cursor="Hand"/>
                <TextBox Grid.Row="1" Text="{Binding BotLogText, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="10"
                         Background="#FFF9F9F9"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>