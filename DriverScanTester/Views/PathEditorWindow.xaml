<Window x:Class="DriverScanTester.Views.PathEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DriverScanTester.ViewModels"
        xmlns:utils="clr-namespace:DriverScanTester.Utils"
        mc:Ignorable="d"
        Title="Path &amp; Profile Editor" Height="900" Width="1200" MinWidth="1050" MinHeight="700">
    <Window.Resources>
        <utils:RouteNumberConverter x:Key="RouteNumberConverter"/>
        <utils:TravelRouteCompletionModeTextConverter x:Key="TravelRouteCompletionModeTextConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- TAB 1: PATH EDITOR -->
            <TabItem Header="Path Editor">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- A. Path point editor -->
                    <GroupBox Header="Current Path Points" Grid.Column="0">
                        <DataGrid ItemsSource="{Binding Points}" AutoGenerateColumns="False" 
                                  SelectedItem="{Binding SelectedPoint}" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="*"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="*"/>
                                <DataGridComboBoxColumn Header="Precision" 
                                    ItemsSource="{Binding Source={x:Static vm:EnumSources.MovementPrecisions}}"
                                    SelectedItemBinding="{Binding Precision}" Width="*"/>
                                <DataGridComboBoxColumn Header="Mode" 
                                    ItemsSource="{Binding Source={x:Static vm:EnumSources.BotModes}}"
                                    SelectedItemBinding="{Binding Mode}" Width="*"/>
                                <DataGridComboBoxColumn Header="Zone" 
                                    ItemsSource="{Binding Source={x:Static vm:EnumSources.ZoneRestrictions}}"
                                    SelectedItemBinding="{Binding ZoneRestriction}" Width="*"/>
                                <DataGridTextColumn Header="Cam Lock"
                                    Binding="{Binding CameraDistanceLock, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*"/>
                                <DataGridTextColumn Header="Atk Dis"
                                    Binding="{Binding AttackDisengageDistance, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- B. Path settings and actions -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,0,0,0">
                            <Button Content="Capture Position (Bot)" Command="{Binding CapturePositionCommand}" Margin="0,0,0,10" Padding="8" Background="#FFE6F7FF" FontWeight="Bold"/>
                            
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Add (0,0)" Command="{Binding AddPointCommand}" Margin="0,0,2,0"/>
                                <Button Grid.Column="1" Content="Remove" Command="{Binding RemovePointCommand}" Margin="2,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Move Up" Command="{Binding MovePointUpCommand}" Margin="0,0,2,0"/>
                                <Button Grid.Column="1" Content="Move Down" Command="{Binding MovePointDownCommand}" Margin="2,0,0,0"/>
                            </Grid>

                            <Button Content="Clear All Points" Command="{Binding ClearPathCommand}" Margin="0,0,0,20"/>

                            <CheckBox Content="Loop Path" IsChecked="{Binding LoopRoute}" Margin="0,0,0,10" ToolTip="Start over from first point when finished"/>

                            <Label Content="Path Name (Save As):"/>
                            <TextBox Text="{Binding SegmentName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Padding="3"/>
                            
                            <Label Content="Precision for new points:"/>
                            <ComboBox ItemsSource="{Binding Source={x:Static vm:EnumSources.MovementPrecisions}}"
                                      SelectedItem="{Binding SegmentPrecision}"
                                      Margin="0,0,0,10" Padding="3"
                                      ToolTip="Default precision applied only when adding new points via Add/Capture. Each point in the grid can be edited individually."/>

                            <Label Content="Bot mode for new points:"/>
                            <ComboBox ItemsSource="{Binding Source={x:Static vm:EnumSources.BotModes}}"
                                      SelectedItem="{Binding SegmentBotMode}"
                                      Margin="0,0,0,10" Padding="3"
                                      ToolTip="Default bot mode applied only when adding new points via Add/Capture. Each point in the grid can be edited individually."/>

                            <Label Content="Zone restriction:"/>
                            <ComboBox ItemsSource="{Binding Source={x:Static vm:EnumSources.ZoneRestrictions}}"
                                      SelectedItem="{Binding SegmentZoneRestriction}"
                                      Margin="0,0,0,10" Padding="3"
                                      ToolTip="OutsideOnly = block movement in city. InCityOnly = block movement outside. Both = move anywhere."/>

                            <Label Content="Camera distance lock for new points:"/>
                            <TextBox Text="{Binding SegmentCameraDistanceLockText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" Padding="3"
                                     ToolTip="Default camera distance lock used when adding/capturing new points. The grid value can still be edited per point."/>

                            <Label Content="Attack disengage distance for new points:"/>
                            <TextBox Text="{Binding SegmentAttackDisengageDistanceText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" Padding="3"
                                     ToolTip="If the bot moves farther than this Manhattan distance from the current attack waypoint, it will stop attacking until the waypoint is reached again."/>

                            <Button Content="Save Path" Command="{Binding SaveSegmentCommand}" Margin="0,0,0,20" Padding="5"/>

                            <Separator Height="10"/>
                            <TextBlock Text="To edit an existing path, select it in Saved Paths and click Edit Path." TextWrapping="Wrap" Foreground="Gray" FontSize="10"/>
                            
                            <Button Content="Run This Path" Command="{Binding RunCurrentSegmentCommand}" Margin="0,20,0,0" Padding="5" Background="#FFF0F0F0"/>
                            <Button Content="STOP BOT" Command="{Binding StopBotCommand}" Margin="0,5,0,0" Padding="5" Background="#FFFFCCCC" FontWeight="Bold"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- C. Saved Paths library -->
                    <GroupBox Header="Saved Paths" Grid.Column="2" Margin="10,0,0,0">
                        <Grid Margin="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox Grid.Row="0" ItemsSource="{Binding AvailableSegments}" SelectedItem="{Binding SelectedAvailableSegment}"/>

                            <StackPanel Grid.Row="1" Margin="0,5,0,0">
                                <Button Content="Refresh" Command="{Binding RefreshLibraryCommand}" Margin="0,0,0,5"/>
                                <Button Content="Edit Path" Command="{Binding LoadSegmentCommand}" Margin="0,0,0,5"
                                        ToolTip="Load the selected path into the Path Editor for editing"/>
                                <Button Content="Delete Path" Command="{Binding DeleteSegmentCommand}" Margin="0,0,0,5"
                                        Background="#FFFFE6E6" ToolTip="Permanently delete from disk"/>
                                <Button Content="STOP BOT" Command="{Binding StopBotCommand}" Margin="0,5,0,0"
                                        Padding="5" Background="#FFFFCCCC" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 2: BOT PROFILE -->
            <TabItem Header="Bot Profile">
                <Grid Margin="5" DataContext="{Binding ProfileEditor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Profile toolbar -->
                    <Border Grid.Row="0" BorderBrush="#FF3399FF" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8" Background="#FFF0F8FF">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Profile:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}"
                                      Width="150" VerticalAlignment="Center" IsEditable="True" Margin="0,0,8,0"/>
                            <TextBlock Text="Name:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140" VerticalAlignment="Center" Margin="0,0,8,0" Padding="3"/>
                            <Button Content="New" Command="{Binding NewProfileCommand}" Width="50" Margin="2" Background="#FFE6FFE6" FontWeight="Bold"/>
                            <Button Content="Save" Command="{Binding SaveProfileCommand}" Width="50" Margin="2" Background="#FFE6F7FF" FontWeight="Bold"/>
                            <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Width="55" Margin="2" Background="#FFFFE6E6"/>
                            <Separator Width="1" Margin="5,2" Background="LightGray"/>
                            <Button Content="Refresh Profiles" Command="{Binding RefreshProfilesCommand}" Width="110" Margin="2"/>
                            <Button Content="Refresh Paths" Command="{Binding RefreshPathsCommand}" Width="105" Margin="2"/>
                        </WrapPanel>
                    </Border>

                    <!-- Row 1: Scrollable flow editor -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,5,0">

                            <!-- ─────────── FLOW ─────────── -->
                            <GroupBox Header="FLOW — steps executed in order, cycled" Margin="0,0,0,10" BorderBrush="#FF3399FF" BorderThickness="2" Padding="4">
                                <StackPanel Margin="3">
                                    <TextBlock Text="The bot runs these steps top to bottom. When the ExpLoop step ends (repot needed) it returns to the city and restarts from step 1. Mix Path / Repot / Operation / ExpLoop freely — e.g. Repot → Operation (talk to NPC) → Path (go to exp) → Operation → ExpLoop. Path, Repot and ExpLoop steps can hold a route group (see 'Step routes' below): the bot uses the next route of the group each time the step runs, so e.g. Repot with routes 1-2-3 and ExpLoop with routes 1-2-3 rotate together per cycle."
                                           TextWrapping="Wrap" Foreground="Gray" FontSize="10" Margin="0,0,0,6"/>

                                    <DataGrid ItemsSource="{Binding FlowSteps}"
                                              SelectedItem="{Binding SelectedFlowStep}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="All"
                                              AlternationCount="2147483647"
                                              RowHeaderWidth="0"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              MinHeight="120"
                                              MaxHeight="300"
                                              VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <!-- # -->
                                            <DataGridTemplateColumn Header="#" Width="36" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource RouteNumberConverter}}"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Type -->
                                            <DataGridTemplateColumn Header="Type" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding Source={x:Static vm:EnumSources.BotFlowStepTypes}}"
                                                                  SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                                  BorderThickness="0" Background="Transparent"
                                                                  VerticalAlignment="Center" Margin="2,0"
                                                                  ToolTip="Path = walk a saved segment once. Repot = teleport to city, walk to repot, sell/buy. Operation = run a named custom operation. ExpLoop = loop the hunting path until repot is needed. Path, Repot and ExpLoop steps can hold a route group — the bot uses the next route each time the step runs."/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Path (Path/ExpLoop) -->
                                            <DataGridTemplateColumn Header="Path" Width="2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.AvailablePaths, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                  SelectedItem="{Binding PathFile, UpdateSourceTrigger=PropertyChanged}"
                                                                  BorderThickness="0" Background="Transparent"
                                                                  VerticalAlignment="Center" Margin="2,0"
                                                                  Visibility="{Binding PathColumnVisibility}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Operation -->
                                            <DataGridTemplateColumn Header="Operation" Width="1.5*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.AvailableOperations, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                  SelectedItem="{Binding OperationName, UpdateSourceTrigger=PropertyChanged}"
                                                                  BorderThickness="0" Background="Transparent"
                                                                  VerticalAlignment="Center" Margin="2,0"
                                                                  Visibility="{Binding OperationColumnVisibility}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Wait (ms) -->
                                            <DataGridTextColumn Header="Wait (ms)" Width="75"
                                                                Binding="{Binding StartDelayMs, UpdateSourceTrigger=PropertyChanged}"/>

                                            <!-- Finish when (Path only) -->
                                            <DataGridTemplateColumn Header="Finish when" Width="1.3*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding Source={x:Static vm:EnumSources.TravelRouteCompletionModes}}"
                                                                  SelectedItem="{Binding CompletionMode, UpdateSourceTrigger=PropertyChanged}"
                                                                  BorderThickness="0" Background="Transparent"
                                                                  VerticalAlignment="Center" Margin="2,0"
                                                                  Visibility="{Binding PathOnlyColumnVisibility}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Converter={StaticResource TravelRouteCompletionModeTextConverter}}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Dest map (Path only) -->
                                            <DataGridTemplateColumn Header="Dest map" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding ExpectedDestinationMapNumber, UpdateSourceTrigger=PropertyChanged}"
                                                                 BorderThickness="0" Background="Transparent"
                                                                 VerticalAlignment="Center" Margin="2,0"
                                                                 Visibility="{Binding PathOnlyColumnVisibility}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Add step" Command="{Binding AddFlowStepCommand}" Width="80" Margin="0,0,4,0" Background="#FFE6F7FF"/>
                                        <Button Content="Remove" Command="{Binding RemoveFlowStepCommand}" Width="70" Margin="0,0,4,0" Background="#FFFFE6E6"/>
                                        <Button Content="Move up" Command="{Binding MoveFlowStepUpCommand}" Width="75" Margin="0,0,4,0"/>
                                        <Button Content="Move down" Command="{Binding MoveFlowStepDownCommand}" Width="85" Margin="0,0,4,0"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- ─────────── STEP ROUTES (selected Path / Repot / ExpLoop step) ─────────── -->
                            <GroupBox Header="Step routes (for the selected step)" Margin="0,0,0,10" BorderBrush="#FF99CCFF" BorderThickness="1" Padding="4">
                                <GroupBox.Style>
                                    <Style TargetType="GroupBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFlowStep.Type}" Value="Path">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedFlowStep.Type}" Value="Repot">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedFlowStep.Type}" Value="ExpLoop">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </GroupBox.Style>
                                <StackPanel Margin="3">
                                    <TextBlock Text="The bot uses the NEXT route in this list every time this step runs (wraps back to the first). Repot: walk to the repot point. Path: walk the route once. ExpLoop: hunt the route until repot is needed. With several routes (e.g. repot 1, 2, 3) the step's route group rotates one route per flow cycle, so a Repot group of 3 and an ExpLoop group of 3 stay in sync: cycle 1 = repot 1 + exp 1, cycle 2 = repot 2 + exp 2, cycle 3 = repot 3 + exp 3. The 'Start check' column runs the start-position protection before that route: teleport to town if not on the profile's start position, then verify map + position."
                                               TextWrapping="Wrap" Foreground="Gray" FontSize="10" Margin="0,0,0,6"/>

                                    <DataGrid ItemsSource="{Binding SelectedFlowStep.StepRoutes}"
                                              SelectedItem="{Binding SelectedFlowStep.SelectedStepRoute}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="All"
                                              AlternationCount="2147483647"
                                              RowHeaderWidth="0"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              MinHeight="70"
                                              MaxHeight="180"
                                              VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <!-- # -->
                                            <DataGridTemplateColumn Header="#" Width="36" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource RouteNumberConverter}}"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Path -->
                                            <DataGridTemplateColumn Header="Path" Width="2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.AvailablePaths, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                  SelectedItem="{Binding PathFile, UpdateSourceTrigger=PropertyChanged}"
                                                                  BorderThickness="0" Background="Transparent"
                                                                  VerticalAlignment="Center" Margin="2,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Wait (ms) -->
                                            <DataGridTextColumn Header="Wait (ms)" Width="80"
                                                                Binding="{Binding StartDelayMs, UpdateSourceTrigger=PropertyChanged}"/>

                                            <!-- Start check -->
                                            <DataGridCheckBoxColumn Header="Start check" Width="75"
                                                                    Binding="{Binding StartCheckEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Add route" Command="{Binding AddRouteCommand}" Width="80" Margin="0,0,4,0" Background="#FFE6F7FF"/>
                                        <Button Content="Remove" Command="{Binding RemoveRouteCommand}" Width="70" Margin="0,0,4,0" Background="#FFFFE6E6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- ─────────── REPOT WHEN ─────────── -->
                            <GroupBox Header="Repot when" Margin="0,0,0,10" BorderBrush="#FF99CCFF" BorderThickness="1" Padding="4">
                                <Grid Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Minimum HP potions:"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MinHpPotions, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2" HorizontalAlignment="Left"/>

                                    <Label Grid.Row="0" Grid.Column="2" Content="Minimum mana potions:"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MinManaPotions, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2" HorizontalAlignment="Left"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Maximum weight (%):"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxWeightPercent, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2" HorizontalAlignment="Left"/>

                                    <Label Grid.Row="1" Grid.Column="2" Content="Minimum HP:"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MinHp, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2" HorizontalAlignment="Left"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Minimum mana:"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MinMana, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2" HorizontalAlignment="Left"/>
                                </Grid>
                            </GroupBox>

                            <!-- ─────────── BUY POTIONS UP TO ─────────── -->
                            <GroupBox Header="Buy potions up to" Margin="0,0,0,10" BorderBrush="#FF99CCFF" BorderThickness="1" Padding="4">
                                <Grid Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="HP" FontWeight="Bold"/>
                                        <TextBox Text="{Binding HpBuyTarget, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Mana" FontWeight="Bold"/>
                                        <TextBox Text="{Binding ManaBuyTarget, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="Red" FontWeight="Bold"/>
                                        <TextBox Text="{Binding RedBuyTarget, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="White" FontWeight="Bold"/>
                                        <TextBox Text="{Binding WhiteBuyTarget, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- ─────────── START POSITION CHECK / PROTECTION ─────────── -->
                            <GroupBox Header="Start position check (protection)" Margin="0,0,0,10" BorderBrush="#FF99CCFF" BorderThickness="1" Padding="4">
                                <StackPanel Margin="3">
                                    <CheckBox Content="Enable start check — teleport to town when the player is not on the start position"
                                              IsChecked="{Binding StartPositionCheckEnabled}" Margin="2" VerticalAlignment="Center"
                                              ToolTip="When enabled, the bot compares the player position with the start coordinates below before starting. If they differ it uses the town teleport scroll, waits ~10 s for the game to settle, takes a quick step so the game refreshes the (stale) position memory, then instantly verifies that the current map matches the protected map AND that the player is back on the start coordinates (within the tolerance). If the verification fails the bot stops instead of starting."/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Label Grid.Row="0" Grid.Column="0" Content="Start X:"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StartPositionX, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2" HorizontalAlignment="Left"
                                                 ToolTip="Expected X coordinate of the player when the bot starts."/>
                                        <Label Grid.Row="0" Grid.Column="2" Content="Start Y:"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding StartPositionY, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2" HorizontalAlignment="Left"
                                                 ToolTip="Expected Y coordinate of the player when the bot starts."/>
                                        <Label Grid.Row="0" Grid.Column="4" Content="Protected map:"/>
                                        <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding ProtectionMapNumber, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2" HorizontalAlignment="Left"
                                                 ToolTip="Map number the player must be on after the start teleport (e.g. the town map). 0 disables the map check."/>

                                        <Label Grid.Row="1" Grid.Column="0" Content="Tolerance:"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartPositionTolerance, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2" HorizontalAlignment="Left"
                                                 ToolTip="Tolerance in game tiles for the start-position comparison. After a teleport the game only refreshes the position once the player moves, so the bot takes a quick step first and accepts any position within this distance of the start coordinates (default 5)."/>
                                    </Grid>

                                    <Button Content="Set from current position (X, Y + map)" Command="{Binding CaptureStartPositionCommand}" Width="230" Margin="0,8,0,0" HorizontalAlignment="Left" Background="#FFE6F7FF"
                                            ToolTip="Reads the player position and the current map from the game and fills Start X, Start Y and Protected map. Stand on the spot you want the bot to start from before clicking."/>
                                </StackPanel>
                            </GroupBox>

                            <!-- ─────────── ADVANCED ─────────── -->
                            <Expander Header="Advanced settings" IsExpanded="False" Margin="0,0,0,8">
                                <Grid Margin="3,8,3,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Dry Run Repot"
                                              IsChecked="{Binding DryRunRepot}" Margin="2" VerticalAlignment="Center"
                                              ToolTip="Skip the actual sell/buy repot sequence (just log it)."/>

                                    <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Loot Priority (loot over attack)"
                                              IsChecked="{Binding LootPriority}" Margin="2" VerticalAlignment="Center"
                                              ToolTip="During the ExpLoop step, looting outranks combat and waypoint movement. When a loot item is found the bot loots it first."/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Teleport Key:"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TeleportKey, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="2" HorizontalAlignment="Left"/>

                                    <Label Grid.Row="3" Grid.Column="0" Content="Teleport Scan Code:"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TeleportScanCode, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="2" HorizontalAlignment="Left"/>

                                    <Label Grid.Row="4" Grid.Column="0" Content="Max Teleport Retries:"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxTeleportRetries, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="2" HorizontalAlignment="Left"/>

                                    <Label Grid.Row="5" Grid.Column="0" Content="Window Offset X:"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding WindowOffsetX, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="2" HorizontalAlignment="Left"/>

                                    <Label Grid.Row="6" Grid.Column="0" Content="Window Offset Y:"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding WindowOffsetY, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="2" HorizontalAlignment="Left"/>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 2: Status -->
                    <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="5" Margin="0,5,0,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="Blue" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="5">
            <TextBlock Text="{Binding StatusText}" Foreground="Blue" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>