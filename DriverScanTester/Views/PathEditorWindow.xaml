<Window x:Class="DriverScanTester.Views.PathEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DriverScanTester.ViewModels"
        xmlns:utils="clr-namespace:DriverScanTester.Utils"
        mc:Ignorable="d"
        Title="Path &amp; Route Editor" Height="900" Width="1200" MinWidth="1050" MinHeight="700">
    <Window.Resources>
        <utils:RouteNumberConverter x:Key="RouteNumberConverter"/>
        <utils:TravelRouteCompletionModeTextConverter x:Key="TravelRouteCompletionModeTextConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- TAB 1: SEGMENT CREATOR -->
            <TabItem Header="Segment Creator">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- A. Segment point editor -->
                    <GroupBox Header="Current Segment Points" Grid.Column="0">
                        <DataGrid ItemsSource="{Binding Points}" AutoGenerateColumns="False" 
                                  SelectedItem="{Binding SelectedPoint}" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="*"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="*"/>
                                <DataGridComboBoxColumn Header="Precision" 
                                    ItemsSource="{Binding Source={x:Static vm:EnumSources.MovementPrecisions}}"
                                    SelectedItemBinding="{Binding Precision}" Width="*"/>
                                <DataGridComboBoxColumn Header="Mode" 
                                    ItemsSource="{Binding Source={x:Static vm:EnumSources.BotModes}}"
                                    SelectedItemBinding="{Binding Mode}" Width="*"/>
                                <DataGridComboBoxColumn Header="Zone" 
                                    ItemsSource="{Binding Source={x:Static vm:EnumSources.ZoneRestrictions}}"
                                    SelectedItemBinding="{Binding ZoneRestriction}" Width="*"/>
                                <DataGridTextColumn Header="Cam Lock"
                                    Binding="{Binding CameraDistanceLock, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*"/>
                                <DataGridTextColumn Header="Atk Dis"
                                    Binding="{Binding AttackDisengageDistance, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- B. Segment settings and actions -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,0,0,0">
                            <Button Content="Capture Position (Bot)" Command="{Binding CapturePositionCommand}" Margin="0,0,0,10" Padding="8" Background="#FFE6F7FF" FontWeight="Bold"/>
                            
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Add (0,0)" Command="{Binding AddPointCommand}" Margin="0,0,2,0"/>
                                <Button Grid.Column="1" Content="Remove" Command="{Binding RemovePointCommand}" Margin="2,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Move Up" Command="{Binding MovePointUpCommand}" Margin="0,0,2,0"/>
                                <Button Grid.Column="1" Content="Move Down" Command="{Binding MovePointDownCommand}" Margin="2,0,0,0"/>
                            </Grid>

                            <Button Content="Clear All Points" Command="{Binding ClearPathCommand}" Margin="0,0,0,20"/>

                            <CheckBox Content="Loop Path" IsChecked="{Binding LoopRoute}" Margin="0,0,0,10" ToolTip="Start over from first point when finished"/>

                            <Label Content="Segment Name (Save As):"/>
                            <TextBox Text="{Binding SegmentName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Padding="3"/>
                            
                            <Label Content="Precision for new points:"/>
                            <ComboBox ItemsSource="{Binding Source={x:Static vm:EnumSources.MovementPrecisions}}"
                                      SelectedItem="{Binding SegmentPrecision}"
                                      Margin="0,0,0,10" Padding="3"
                                      ToolTip="Default precision applied only when adding new points via Add/Capture. Each point in the grid can be edited individually."/>

                            <Label Content="Bot mode for new points:"/>
                            <ComboBox ItemsSource="{Binding Source={x:Static vm:EnumSources.BotModes}}"
                                      SelectedItem="{Binding SegmentBotMode}"
                                      Margin="0,0,0,10" Padding="3"
                                      ToolTip="Default bot mode applied only when adding new points via Add/Capture. Each point in the grid can be edited individually."/>

                            <Label Content="Zone restriction:"/>
                            <ComboBox ItemsSource="{Binding Source={x:Static vm:EnumSources.ZoneRestrictions}}"
                                      SelectedItem="{Binding SegmentZoneRestriction}"
                                      Margin="0,0,0,10" Padding="3"
                                      ToolTip="OutsideOnly = block movement in city. InCityOnly = block movement outside. Both = move anywhere."/>

                            <Label Content="Camera distance lock for new points:"/>
                            <TextBox Text="{Binding SegmentCameraDistanceLockText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" Padding="3"
                                     ToolTip="Default camera distance lock used when adding/capturing new points. The grid value can still be edited per point."/>

                            <Label Content="Attack disengage distance for new points:"/>
                            <TextBox Text="{Binding SegmentAttackDisengageDistanceText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" Padding="3"
                                     ToolTip="If the bot moves farther than this Manhattan distance from the current attack waypoint, it will stop attacking until the waypoint is reached again."/>

                            <Button Content="Save Segment to Library" Command="{Binding SaveSegmentCommand}" Margin="0,0,0,20" Padding="5"/>

                            <Separator Height="10"/>
                            <TextBlock Text="To edit an existing segment, select it in the Saved Segment Library and click Load into Editor." TextWrapping="Wrap" Foreground="Gray" FontSize="10"/>
                            
                            <Button Content="RUN THIS SEGMENT ONLY" Command="{Binding RunCurrentSegmentCommand}" Margin="0,20,0,0" Padding="5" Background="#FFF0F0F0"/>
                            <Button Content="STOP BOT" Command="{Binding StopBotCommand}" Margin="0,5,0,0" Padding="5" Background="#FFFFCCCC" FontWeight="Bold"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- C. Saved Segment Library -->
                    <GroupBox Header="Saved Segment Library" Grid.Column="2" Margin="10,0,0,0">
                        <Grid Margin="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox Grid.Row="0" ItemsSource="{Binding AvailableSegments}" SelectedItem="{Binding SelectedAvailableSegment}"/>

                            <StackPanel Grid.Row="1" Margin="0,5,0,0">
                                <Button Content="Refresh" Command="{Binding RefreshLibraryCommand}" Margin="0,0,0,5"/>
                                <Button Content="Load into Editor" Command="{Binding LoadSegmentCommand}" Margin="0,0,0,5"
                                        ToolTip="Load the selected segment into the Segment Creator for editing"/>
                                <Button Content="Delete Segment" Command="{Binding DeleteSegmentCommand}" Margin="0,0,0,5"
                                        Background="#FFFFE6E6" ToolTip="Permanently delete from disk"/>
                                <Button Content="STOP BOT" Command="{Binding StopBotCommand}" Margin="0,5,0,0"
                                        Padding="5" Background="#FFFFCCCC" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 2: PROFILE EDITOR -->
            <TabItem Header="Profile Editor">
                <Grid Margin="5" DataContext="{Binding ProfileEditor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Profile toolbar -->
                    <Border Grid.Row="0" BorderBrush="#FF3399FF" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8" Background="#FFF0F8FF">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Profile:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}"
                                      Width="150" VerticalAlignment="Center" IsEditable="True" Margin="0,0,5,0"/>
                            <Button Content="New" Command="{Binding NewProfileCommand}" Width="50" Margin="2" Background="#FFE6FFE6" FontWeight="Bold"/>
                            <Button Content="Save" Command="{Binding SaveProfileCommand}" Width="50" Margin="2" Background="#FFE6F7FF" FontWeight="Bold"/>
                            <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Width="55" Margin="2" Background="#FFFFE6E6"/>
                            <Button Content="Refresh Profiles" Command="{Binding RefreshProfilesCommand}" Width="110" Margin="2"/>
                            <Separator Width="1" Margin="5,2" Background="LightGray"/>
                            <Button Content="Refresh Segments" Command="{Binding RefreshSegmentsCommand}" Width="120" Margin="2"/>
                        </WrapPanel>
                    </Border>

                    <!-- Row 1: Scrollable workflow content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,5,0">

                            <!-- General and repot settings -->
                            <GroupBox Header="General and Repot Settings" Margin="0,0,0,8">
                                <Grid Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Name:"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Min HP Pots:"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinHpPotions, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Min Mana Pots:"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MinManaPotions, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="3" Grid.Column="0" Content="Max Weight Ratio:"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxWeightRatio, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="4" Grid.Column="0" Content="Min HP:"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MinHp, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="5" Grid.Column="0" Content="Min Mana:"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MinMana, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="6" Grid.Column="0" Content="HP Buy Target:"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding HpBuyTarget, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="7" Grid.Column="0" Content="Mana Buy Target:"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ManaBuyTarget, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="8" Grid.Column="0" Content="Red Buy Target:"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding RedBuyTarget, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="9" Grid.Column="0" Content="White Buy Target:"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding WhiteBuyTarget, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <CheckBox Grid.Row="10" Grid.Column="1" Content="Dry Run Repot" IsChecked="{Binding DryRunRepot}" Margin="2"/>
                                </Grid>
                            </GroupBox>

                            <!-- Advanced workflow settings -->
                            <GroupBox Header="Advanced Workflow Settings" Margin="0,0,0,8">
                                <Grid Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Teleport Key:"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TeleportKey, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Teleport Scan Code:"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TeleportScanCode, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Max Teleport Retries:"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxTeleportRetries, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="3" Grid.Column="0" Content="Window Offset X:"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WindowOffsetX, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                                    <Label Grid.Row="4" Grid.Column="0" Content="Window Offset Y:"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding WindowOffsetY, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                </Grid>
                            </GroupBox>

                            <!-- Stage 1 card: City → Repot (profile-level) -->
                            <GroupBox Header="Stage 1 — City → Repot (profile-level)" Margin="0,0,0,8" BorderBrush="#FF3399FF" BorderThickness="1">
                                <StackPanel Margin="3">
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Saved Path:" FontWeight="Bold" VerticalAlignment="Center" Width="90"/>
                                        <ComboBox ItemsSource="{Binding AvailableSegments}" SelectedItem="{Binding CityToRepot.PathFile}"
                                                  Width="300" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Wait before start (ms):" FontWeight="Bold" VerticalAlignment="Center" Width="140"/>
                                        <TextBox Text="{Binding CityToRepot.StartDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <TextBlock Text="Only one City → Repot path is supported for now. Additional city-to-repot path selection will be designed later."
                                               TextWrapping="Wrap" Foreground="Gray" FontSize="10"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Hunt selector (master-detail) -->
                            <GroupBox Header="Hunts" Margin="0,0,0,8" BorderBrush="#FF3399FF" BorderThickness="1">
                                <Grid Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Master: hunt list -->
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ListBox Grid.Row="0" ItemsSource="{Binding HuntDefinitions}" SelectedItem="{Binding SelectedHunt}" Margin="0,0,0,5">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"/>
                                                        <TextBlock Text=" (default)" Foreground="#FF008000" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                            <Button Content="Add Hunt" Command="{Binding AddHuntCommand}" Width="80" Margin="0,0,2,0" Background="#FFE6F7FF"/>
                                            <Button Content="Remove" Command="{Binding RemoveHuntCommand}" Width="65" Margin="2,0,0,0" Background="#FFFFE6E6"/>
                                            <Button Content="▲" Command="{Binding MoveHuntUpCommand}" Width="28" Margin="4,0,2,0" ToolTip="Move up"/>
                                            <Button Content="▼" Command="{Binding MoveHuntDownCommand}" Width="28" Margin="0,0,4,0" ToolTip="Move down"/>
                                            <Button Content="Set as Default" Command="{Binding SetDefaultHuntCommand}" Width="110" Margin="0,3,0,0" Background="#FFE6FFE6"/>
                                        </WrapPanel>
                                    </Grid>

                                    <!-- Detail: selected hunt stages -->
                                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Hunt Name:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBox Text="{Binding SelectedHunt.Name, UpdateSourceTrigger=PropertyChanged}" Width="200" VerticalAlignment="Center" Padding="3"/>
                                            </WrapPanel>

                                            <!-- Stage 2: Travel Routes (Repot → EXP) -->
                                            <GroupBox Header="Stage 2 — Travel Routes: Repot → EXP" Margin="0,0,0,8" BorderBrush="#FF66B2FF" BorderThickness="1">
                                                <Grid Margin="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="300"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: ordered route list -->
                                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <ListBox Grid.Row="0" ItemsSource="{Binding SelectedHunt.TravelToExpRoutes}"
                                                                 SelectedItem="{Binding SelectedHunt.SelectedTravelRoute}"
                                                                 AlternationCount="2147483647" Margin="0,0,0,5">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="2">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock FontWeight="Bold"
                                                                                       Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource RouteNumberConverter}, StringFormat='Route {0}: '}"/>
                                                                            <TextBlock Text="{Binding PathFile}"/>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                                                            <TextBlock Text="{Binding CompletionMode, Converter={StaticResource TravelRouteCompletionModeTextConverter}}" Foreground="Gray"/>
                                                                            <TextBlock Text="{Binding ExpectedDestinationMapNumber, StringFormat=' → Map {0}'}" Foreground="Gray">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding CompletionMode}" Value="ExpectedMapReached">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>

                                                        <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                                            <Button Content="Add Route" Command="{Binding AddTravelRouteCommand}" Width="80" Margin="0,0,2,0" Background="#FFE6F7FF"/>
                                                            <Button Content="Remove" Command="{Binding RemoveTravelRouteCommand}" Width="65" Margin="2,0,0,0" Background="#FFFFE6E6"/>
                                                            <Button Content="▲" Command="{Binding MoveTravelRouteUpCommand}" Width="28" Margin="4,0,2,0" ToolTip="Move up"/>
                                                            <Button Content="▼" Command="{Binding MoveTravelRouteDownCommand}" Width="28" Margin="0,0,4,0" ToolTip="Move down"/>
                                                        </WrapPanel>
                                                    </Grid>

                                                    <!-- Right: selected route editor -->
                                                    <Grid Grid.Column="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Label Grid.Row="0" Grid.Column="0" Content="Saved Path:"/>
                                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableSegments}"
                                                                  SelectedItem="{Binding SelectedHunt.SelectedTravelRoute.PathFile}"
                                                                  Width="300" Margin="2" HorizontalAlignment="Left"/>

                                                        <Label Grid.Row="1" Grid.Column="0" Content="Wait before start (ms):"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedHunt.SelectedTravelRoute.StartDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="100" Margin="2" HorizontalAlignment="Left"/>

                                                        <Label Grid.Row="2" Grid.Column="0" Content="Complete when:"/>
                                                        <ComboBox Grid.Row="2" Grid.Column="1"
                                                                  ItemsSource="{Binding Source={x:Static vm:EnumSources.TravelRouteCompletionModes}}"
                                                                  SelectedItem="{Binding SelectedHunt.SelectedTravelRoute.CompletionMode}"
                                                                  Width="180" Margin="2" HorizontalAlignment="Left">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Converter={StaticResource TravelRouteCompletionModeTextConverter}}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>

                                                        <Label Grid.Row="3" Grid.Column="0" Content="Expected destination map:"/>
                                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                                 Text="{Binding SelectedHunt.SelectedTravelRoute.ExpectedDestinationMapNumber, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="100" Margin="2" HorizontalAlignment="Left">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedHunt.SelectedTravelRoute.CompletionMode}" Value="ExpectedMapReached">
                                                                            <Setter Property="IsEnabled" Value="True"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                    </Grid>
                                                </Grid>
                                            </GroupBox>

                                            <!-- Stage 3: EXP Loop -->
                                            <GroupBox Header="Stage 3 — EXP Loop" Margin="0,0,0,8" BorderBrush="#FF66B2FF" BorderThickness="1">
                                                <StackPanel Margin="3">
                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                        <TextBlock Text="Saved Path:" FontWeight="Bold" VerticalAlignment="Center" Width="90"/>
                                                        <ComboBox ItemsSource="{Binding AvailableSegments}" SelectedItem="{Binding SelectedHunt.ExpLoop.PathFile}"
                                                                  Width="300" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                        <TextBlock Text="Wait before start (ms):" FontWeight="Bold" VerticalAlignment="Center" Width="140"/>
                                                        <TextBox Text="{Binding SelectedHunt.ExpLoop.StartDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="100" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="The selected path loops until repot is needed."
                                                               TextWrapping="Wrap" Foreground="Gray" FontSize="10"/>
                                                </StackPanel>
                                            </GroupBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 2: Status -->
                    <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="5" Margin="0,5,0,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="Blue" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="5">
            <TextBlock Text="{Binding StatusText}" Foreground="Blue" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
