<Window x:Class="DriverScanTester.Views.PixelDetectionTestingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DriverScanTester.ViewModels"
        Title="Pixel Detection Tests"
        Height="500"
        Width="700"
        MinHeight="400"
        MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Foreground="DimGray"
                   Text="Runs the selected detector against a fresh capture of the game client. These tests are read-only: they do not move the mouse, target objects, collect loot, or teleport."/>

        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="Test:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox DockPanel.Dock="Left"
                      Width="280"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedTest, Mode=TwoWay}"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="Other-player markers (yellow / green)"
                              Tag="{x:Static vm:PixelDetectionTestKind.OtherPlayerMarkers}"/>
                <ComboBoxItem Content="SOD/SOP pink loot pixels"
                              Tag="{x:Static vm:PixelDetectionTestKind.SodSopLoot}"/>
            </ComboBox>
            <Button DockPanel.Dock="Left"
                    Content="Test"
                    Command="{Binding TestCommand}"
                    Width="90"
                    Margin="10,0,0,0"
                    Padding="8,4"
                    FontWeight="Bold"/>
        </DockPanel>

        <GroupBox Grid.Row="2" Header="Test log">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="#FFF9F9F9"
                     Padding="8"/>
        </GroupBox>
    </Grid>
</Window>
